NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Generate independent secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=replace-with-at-least-64-random-hex-characters
DATA_ENCRYPTION_KEY=replace-with-exactly-64-random-hex-characters
DB_HOST=your-managed-mysql-host
DB_PORT=your-provider-port
DB_NAME=exampro
DB_USER=exampro_runtime
DB_PASSWORD=replace-me
# Base64 encoded CA PEM downloaded from your database provider; TLS is always required.
DB_SSL_CA_BASE64=replace-with-base64-ca-certificate
DB_POOL_SIZE=3
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=replace-with-resend-api-key
SMTP_FROM=EXAMPRO <exams@your-verified-domain.example>
CRON_SECRET=replace-with-independent-random-secret
# Required only for one-time CLI bootstrap; remove after provisioning.
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-strong-unique-password
# Dedicated disposable MySQL database only for opt-in integration tests.
INTEGRATION_TESTS=false
# Optional real provider test only. Charges may apply; use destinations you own.
LIVE_TEST_CONFIRM=no
LIVE_TEST_EMAIL=replace-with-unused-email-you-own
LIVE_TEST_PHONE=replace-with-unused-phone-you-own
