{
  "name": "exampro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "npm run build && node --watch backend/src/server.js",
    "build": "node scripts/check.js",
    "lint": "eslint .",
    "test": "node --experimental-test-module-mocks --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "db:migrate": "node scripts/migrate.js",
    "db:check": "node scripts/db-check.js",
    "admin:create": "node scripts/bootstrap-admin.js",
    "jobs": "node scripts/jobs.js",
    "format": "prettier --write backend frontend scripts tests app.js eslint.config.js package.json vercel*.json README.md",
    "dev:ui": "vite",
    "pretest": "npm run build"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bootstrap": "^5.3.8",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.3",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.17.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "vite": "^8.3.4"
  }
}
